{
	"name": "obsidian-open-bible",
	"version": "0.1.0",
	"description": "Plugin OpenBible para Obsidian — interface em Svelte.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"svelte-check": "svelte-check --tsconfig tsconfig.json",
		"deploy": "mkdir -p \"/Users/claudio/Projects/vault-teste/.obsidian/plugins/obsidian-open-bible\" && cp main.js manifest.json styles.css \"/Users/claudio/Projects/vault-teste/.obsidian/plugins/obsidian-open-bible/\"",
		"build:deploy": "npm run build && npm run deploy",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"bible",
		"svelte"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.10.0",
		"@types/sql.js": "^1.4.11",
		"builtin-modules": "^5.0.0",
		"esbuild": "^0.24.2",
		"esbuild-svelte": "^0.9.3",
		"obsidian": "latest",
		"sql.js": "^1.14.2",
		"svelte": "^5.0.0",
		"svelte-check": "^4.1.0",
		"svelte-preprocess": "^6.0.3",
		"tslib": "2.8.1",
		"typescript": "~5.9.0"
	}
}
